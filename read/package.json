{
  "name": "@ask-marcel/office-read",
  "version": "1.0.0",
  "description": "Microsoft Graph read commands for agents: every command that changes nothing in the tenant, with on-the-fly markdown conversion.",
  "license": "MIT",
  "author": "Vincent Delacourt <vincent.delacourt@adama-development.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ask-marcel/ask-marcel-office-cli.git",
    "directory": "read"
  },
  "bugs": {
    "url": "https://github.com/ask-marcel/ask-marcel-office-cli/issues"
  },
  "homepage": "https://github.com/ask-marcel/ask-marcel-office-cli/tree/main/read#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands.json": "./dist/commands.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "ask-marcel-office-read": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "README.md",
    "USAGE.md",
    "COMMANDS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint --cache --max-warnings=0",
    "lint:staged": "bash ../scripts/lint-staged.sh",
    "lint:strict": "LINT_STRICT=1 eslint --max-warnings=0",
    "typecheck": "bun --bun x tsc --noEmit",
    "test": "bun test --randomize",
    "coverage": "bun run ../scripts/check-coverage.ts --preload ../scripts/coverage-preload-tiers.ts",
    "mutate": "stryker run",
    "mutate:changed": "bash ../scripts/mutate-changed.sh",
    "mutate:staged": "bash ../scripts/mutate-staged.sh",
    "docs:gen": "bun run ../scripts/gen-docs.ts --package src/composition/single-package.ts --commands-doc COMMANDS.md",
    "check:docs": "bun run ../scripts/gen-docs.ts --package src/composition/single-package.ts --check --commands-doc COMMANDS.md --manifest dist/commands.json && bun run ../scripts/check-doc-numbers.ts --package src/composition/single-package.ts --readme README.md --usage USAGE.md --commands-doc COMMANDS.md --manifest dist/commands.json",
    "build": "rm -rf dist && bun run ../scripts/build-package.ts && bun run ../scripts/add-shebang.ts dist/cli.js && bun run ../scripts/build-types.ts && bun run ../scripts/gen-docs.ts --package src/composition/single-package.ts --manifest dist/commands.json",
    "check:packed": "bun run ../scripts/check-packed-package.ts",
    "smoke": "bun ../scripts/qa-bundle-smoke.ts",
    "smoke:packed": "bun ../scripts/qa-packed-install-smoke.ts",
    "prepublishOnly": "bun run build && bun run lint:strict && bun run typecheck && bun run coverage && bun run check:packed"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "postal-mime": "~4.0.11",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": ">=1.6.2 <1.8.0",
    "update-notifier": "^7.3.1",
    "winston": "^3.19.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ask-marcel/office-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "docx": "^9.6.1"
  }
}
