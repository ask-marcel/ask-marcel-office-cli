{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun"]
  },
  // Each workspace folder (core/, auth/, read/, write/) typechecks itself with
  // its own tsconfig.json (package split, D7). The root checks its scripts and
  // configs only; dist/, .stryker-tmp/ and reports/ are build and run output
  // that an old local run can leave at the root.
  "exclude": ["node_modules", "auth", "core", "read", "write", "dist", ".stryker-tmp", "reports"]
}
